# Variables the worker reads: the shared runtime ones (plan D-01) and its own.
BATCH_SIZE=100
RUN_TIMEOUT=30s
HTTP_TIMEOUT=5s
HTTP_ATTEMPTS=3
# time between two runs (ADR-004 D10, every five minutes by default)
REPROGRAMMING_INTERVAL=5m
# where the health endpoint listens
HEALTH_ADDR=:8080
# internal base URL on the platform network: no trailing path, no credentials
COMMERCIAL_RESERVATION_BASE_URL=http://commercial-reservation-api:8083
# a SERVICE token issued by multi-tour-security: `security issue-service-token worker-reprogramming-timers <duration>`; a secret of
# the environment, never versioned
SERVICE_TOKEN=
